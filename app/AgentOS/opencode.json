{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/free",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute free combo (127.0.0.1)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:AGENT_OS_FREE_KEY}"
      },
      "models": { "free": { "name": "free (fallback across free providers)" } }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama on this PC",
      "options": { "baseURL": "http://127.0.0.1:11434/v1" },
      "models": {
        "fast": { "name": "fast (gemma4 12B, 16K)" },
        "qwen-agent": { "name": "qwen-agent (tool calls, ~11 GB VRAM)" }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": { "*": "deny", "python -m unittest*": "allow", "git status*": "allow", "git diff*": "allow" }
  }
}
